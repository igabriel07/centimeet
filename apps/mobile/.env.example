# Supabase (Project Settings → API). Το publishable/anon key είναι ασφαλές για το app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Το backend του CentiMeet (στο κινητό βάλτε την IP του υπολογιστή, όχι localhost)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787

# ---------- Παραγωγή ----------
# Αναφορές σφαλμάτων (Sentry, δωρεάν πλάνο). Κενό = απενεργοποιημένο.
EXPO_PUBLIC_SENTRY_DSN=
# Στοιχεία για την πολιτική απορρήτου / όρους (src/legal/content.ts)
EXPO_PUBLIC_LEGAL_OPERATOR=
EXPO_PUBLIC_CONTACT_EMAIL=
# Link λήψης της εφαρμογής για το «Πρόσκληση στην εφαρμογή» (π.χ. σελίδα με App Store / Google Play)
EXPO_PUBLIC_INVITE_URL=
# Χάρτης στο Android (Maps SDK for Android, δωρεάν). ΔΕΝ είναι EXPO_PUBLIC: μπαίνει στο build από το app.config.ts.
GOOGLE_MAPS_ANDROID_API_KEY=
