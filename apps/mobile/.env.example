# Supabase (Project Settings → API). Το publishable/anon key είναι ασφαλές για το app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Το backend του CentiMeet (στο κινητό βάλτε την IP του υπολογιστή, όχι localhost)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
