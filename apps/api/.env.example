# Θύρα του API
PORT=8787

# true = ψεύτικα δεδομένα (χωρίς Google, χωρίς κόστος) για ανάπτυξη
USE_MOCK_PROVIDERS=true

# Google Maps Platform: ενεργοποιήστε Places API (New) και Routes API
GOOGLE_MAPS_API_KEY=

# Αναζήτηση διευθύνσεων: auto | google | photon | mock
# auto = Photon (δωρεάν) στη λιτή λειτουργία· Google μόνο με COST_MODE=growth
GEOCODER=auto
PHOTON_URL=https://photon.komoot.io

# Supabase – για έλεγχο του token του χρήστη
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Μόνο αν το project χρησιμοποιεί ακόμη το παλιό HS256 JWT secret.
# Αν μείνει κενό, γίνεται έλεγχος μέσω JWKS (συνιστάται).
SUPABASE_JWT_SECRET=

# false μόνο για τοπική ανάπτυξη
REQUIRE_AUTH=false

# ---------- Κόστος (βλ. docs/DEPLOY.md) ----------
# lean = χωράει στα δωρεάν μηνιαία όρια του Google (Φάση 1) · growth = πληρέστερα αποτελέσματα (Φάση 2)
COST_MODE=lean
# Ποσοστό του δωρεάν ορίου κάθε υπηρεσίας Google τον μήνα πριν περάσουμε σε δωρεάν εφεδρική λειτουργία
# (εκτιμώμενοι χρόνοι + μαγαζιά OpenStreetMap). 0.9 = €0. >1 = ελεγχόμενη υπέρβαση.
GOOGLE_BUDGET_FACTOR=0.9
# Αναζητήσεις ανά χρήστη την ημέρα (0 = χωρίς όριο)
USER_DAILY_SEARCHES=10
# Service role / secret key του Supabase — ΜΟΝΟ εδώ, ποτέ στην εφαρμογή. Απαιτείται με πραγματικό Google.
SUPABASE_SERVICE_ROLE_KEY=
# true μόνο για τοπική δοκιμή με πραγματικό Google χωρίς Supabase (οι μετρητές χάνονται σε κάθε επανεκκίνηση)
ALLOW_MEMORY_USAGE_STORE=false
